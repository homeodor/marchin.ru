---
import Header from "../components/header.astro";
import Filter from "../components/filter.astro";
import Glagne from "../components/glagne.astro";
import type { Release } from "../ts/types";

const releaseModules = import.meta.glob("../releases/*.json", { eager: true });
const releases = Object.values(releaseModules) as Release[];

releases.sort(function (x: Release, y: Release) {
	const xMonths = x.data.year * 12 + (x.data.month ?? 1);
	const yMonths = y.data.year * 12 + (y.data.month ?? 1);
	return xMonths > yMonths ? -1 : xMonths < yMonths ? 1 : 0;
});
---

<!doctype html>
<html lang="ru">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Релизы</title>
		<Header />
	</head>
	<body class="body-releases">
		<Filter />
		<Glagne />
		<main class="releases">
			{
				releases.map((release: Release) => (
					<a class="psycho-out" href={`/release/${release.data.id}`}>
						<div class="cover">
							<img
								src={`/covers/${release.data.id}.jpg`}
								alt=""
							/>
						</div>
						<h2>
							<span class="pseudo-a psycho-in">
								{release.data.title}
							</span>
						</h2>
						<h3>
							{release.data.subtitle && (
								<>
									<span>{release.data.subtitle}</span> <br />
								</>
							)}
							{release.data.year} &bull; {release.data.kind}
						</h3>
					</a>
				))
			}
		</main>
	</body>
</html>
